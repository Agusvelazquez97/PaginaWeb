---
/**
 * BreadcrumbList (JSON-LD) — spec sección 9.1. Usar en cualquier página
 * que no sea Inicio, con la ruta real de navegación.
 */
interface Crumb {
  name: string;
  path: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    item: `${siteUrl}${item.path}`,
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

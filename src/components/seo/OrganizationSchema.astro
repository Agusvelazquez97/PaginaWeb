---
/**
 * Organization + ProfessionalService (JSON-LD) — spec sección 9.1.
 * Se incluye en todas las páginas vía BaseLayout. Solo datos reales ya
 * establecidos en site.ts; sin URL de LinkedIn (sameAs) hasta tenerla.
 */
import { siteConfig } from '@/data/site';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

const sameAs = [siteConfig.linkedInUrl].filter(Boolean);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: siteConfig.name,
  url: siteUrl,
  email: siteConfig.email,
  telephone: `+${siteConfig.whatsappNumber}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Buenos Aires',
    addressCountry: 'AR',
  },
  areaServed: 'AR',
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

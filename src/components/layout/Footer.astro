---
/**
 * Footer global — spec sección 5. LinkedIn queda oculto hasta tener URL real
 * ([FALTA] — ver PENDIENTES.md); no se inventa el enlace.
 */
import { Mail, MessageCircle, MapPin } from '@lucide/astro';
import { footerNav, siteConfig, whatsappHref } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="bg-navy-900 text-blue-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <p class="font-heading font-extrabold text-white text-xl">
          DGV<span class="text-blue-500">.</span> Business Consulting
        </p>
        <p class="mt-3 text-slate-400 max-w-xs">{siteConfig.tagline}</p>
      </div>

      <nav aria-label="Footer">
        <p class="text-small font-semibold uppercase tracking-wide text-slate-400 mb-4">
          Navegación
        </p>
        <ul class="space-y-2.5">
          {footerNav.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-blue-100 hover:text-white transition-colors inline-flex items-center min-h-11"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="text-small font-semibold uppercase tracking-wide text-slate-400 mb-4">
          Contacto
        </p>
        <ul class="space-y-3">
          <li>
            <a
              href={`mailto:${siteConfig.email}`}
              class="inline-flex items-center gap-2 min-h-11 text-blue-100 hover:text-white transition-colors"
            >
              <Mail class="size-4 shrink-0" aria-hidden="true" />
              {siteConfig.email}
            </a>
          </li>
          <li>
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 min-h-11 text-blue-100 hover:text-white transition-colors"
            >
              <MessageCircle class="size-4 shrink-0" aria-hidden="true" />
              {siteConfig.phoneDisplay}
            </a>
          </li>
          <li class="inline-flex items-start gap-2 text-slate-400">
            <MapPin class="size-4 shrink-0 mt-0.5" aria-hidden="true" />
            {siteConfig.location}
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-small text-slate-400"
    >
      <p>© {year} DGV Business Consulting. Todos los derechos reservados.</p>
      <p class="max-w-md">
        Las trayectorias del equipo se comunican en texto, sin usar logos de terceros.
      </p>
    </div>
  </div>
</footer>

---
/**
 * Footer global — spec sección 5. LinkedIn se muestra solo si hay URL real
 * cargada en siteConfig.linkedInUrl; no se inventa el enlace.
 */
import { Mail, MessageCircle, MapPin, ExternalLink } from '@lucide/astro';
import { footerNav, footerNavEn, siteConfig, whatsappHref, whatsappHrefEn } from '@/data/site';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = ui[lang];
const nav = lang === 'en' ? footerNavEn : footerNav;
const waHref = lang === 'en' ? whatsappHrefEn : whatsappHref;
const year = new Date().getFullYear();
---

<footer class="bg-navy-900 text-blue-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <img
          src="/images/brand/dgv-logo.png"
          alt="DGV Business Consulting"
          class="h-8 w-auto"
          width="756"
          height="200"
        />
        <p class="mt-3 text-blue-100/60 max-w-xs">{lang === 'en' ? siteConfig.taglineEn : siteConfig.tagline}</p>
      </div>

      <nav aria-label="Footer">
        <p class="text-small font-semibold uppercase tracking-wide text-blue-100/60 mb-4">
          {t.footerNavHeading}
        </p>
        <ul class="space-y-2.5">
          {nav.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-blue-100 hover:text-white transition-colors inline-flex items-center min-h-11"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="text-small font-semibold uppercase tracking-wide text-blue-100/60 mb-4">
          {t.footerContactHeading}
        </p>
        <ul class="space-y-3">
          <li>
            <a
              href={`mailto:${siteConfig.email}`}
              class="inline-flex items-center gap-2 min-h-11 text-blue-100 hover:text-white transition-colors"
            >
              <Mail class="size-4 shrink-0" aria-hidden="true" />
              {siteConfig.email}
            </a>
          </li>
          <li>
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 min-h-11 text-blue-100 hover:text-white transition-colors"
            >
              <MessageCircle class="size-4 shrink-0" aria-hidden="true" />
              {siteConfig.phoneDisplay}
            </a>
          </li>
          <li class="inline-flex items-start gap-2 text-blue-100/60">
            <MapPin class="size-4 shrink-0 mt-0.5" aria-hidden="true" />
            {siteConfig.location}
          </li>
          {siteConfig.linkedInUrl && (
            <li>
              <a
                href={siteConfig.linkedInUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 min-h-11 text-blue-100 hover:text-white transition-colors"
              >
                <ExternalLink class="size-4 shrink-0" aria-hidden="true" />
                LinkedIn
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div
      class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-small text-blue-100/60"
    >
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
        <p>{t.footerRights(year)}</p>
        <div class="flex items-center gap-4">
          <a href="/politica-privacidad" class="hover:text-white transition-colors underline underline-offset-2">
            {t.footerPrivacy}
          </a>
          <a href="/terminos-condiciones" class="hover:text-white transition-colors underline underline-offset-2">
            {t.footerTerms}
          </a>
        </div>
      </div>
      <p class="max-w-md">
        {t.footerTrayectorias}
      </p>
    </div>
  </div>
</footer>

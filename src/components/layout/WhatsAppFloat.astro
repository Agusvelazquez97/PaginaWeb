---
/**
 * Botón flotante de WhatsApp — spec sección 4, visible en mobile.
 * En desktop el CTA de Contacto en el header ya cumple ese rol.
 */
import { MessageCircle } from '@lucide/astro';
import { whatsappHref, whatsappHrefEn, siteConfig } from '@/data/site';
import { ui, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const href = lang === 'en' ? whatsappHrefEn : whatsappHref;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="lg:hidden fixed bottom-5 right-5 z-40 flex items-center justify-center size-14 rounded-full bg-[#25D366] text-white shadow-card hover:brightness-95 transition"
  aria-label={ui[lang].whatsappAriaLabel(siteConfig.phoneDisplay)}
>
  <MessageCircle class="size-7" aria-hidden="true" />
</a>

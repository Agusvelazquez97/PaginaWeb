---
/**
 * Header sticky — spec sección 4 y 5.
 * Desktop: nav + dropdown "Soluciones" + botón Contacto destacado.
 * Mobile: hamburguesa + botón WhatsApp siempre visible.
 * Selector de idioma ES/EN — feature experimental de i18n (ver PENDIENTES.md):
 * en inglés la nav es plana (solo las 4 páginas traducidas, sin dropdown).
 */
import { Menu, X, ChevronDown, MessageCircle, Globe } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import {
  mainNav,
  mainNavEn,
  solucionesDropdown,
  whatsappHref,
  whatsappHrefEn,
  siteConfig,
} from '@/data/site';
import { ui, type Lang } from '@/i18n/ui';
import { getLocalizedPath } from '@/i18n/routes';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const t = ui[lang];
const homeHref = lang === 'en' ? '/en' : '/';
const contactoHref = lang === 'en' ? '/en/contact' : '/contacto';
const waHref = lang === 'en' ? whatsappHrefEn : whatsappHref;
const esHref = getLocalizedPath(Astro.url.pathname, 'es');
const enHref = getLocalizedPath(Astro.url.pathname, 'en');

const navLinkClass =
  'inline-flex items-center min-h-11 px-3 rounded-btn text-[15px] font-medium text-navy-700 ' +
  'hover:bg-blue-50 hover:text-blue-700 transition-colors';
const langLinkClass = 'inline-flex items-center min-h-11 px-2 text-small font-semibold';
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80 border-b border-navy-700/10"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 md:h-20 items-center justify-between gap-4">
      <a href={homeHref} class="flex items-center min-h-11">
        <img
          src="/images/brand/dgv-logo-light.png"
          alt="DGV Business Consulting"
          class="h-8 md:h-9 w-auto"
          width="756"
          height="200"
        />
      </a>

      <!-- Nav desktop -->
      {lang === 'es' ? (
        <nav aria-label={t.navPrincipal} class="hidden lg:flex items-center gap-1">
          {mainNav.slice(0, 1).map((link) => (
            <a href={link.href} class={navLinkClass}>{link.label}</a>
          ))}

          <div class="relative" data-dropdown>
            <button
              type="button"
              class={`${navLinkClass} gap-1`}
              aria-expanded="false"
              aria-controls="soluciones-menu"
              data-dropdown-trigger
            >
              {t.soluciones}
              <ChevronDown class="size-4 transition-transform" aria-hidden="true" data-dropdown-chevron />
            </button>
            <div
              id="soluciones-menu"
              role="menu"
              class="absolute left-0 top-full mt-2 min-w-64 rounded-card bg-white shadow-card border border-navy-700/10 p-2"
              data-dropdown-panel
              hidden
            >
              {solucionesDropdown.map((link) => (
                <a
                  role="menuitem"
                  href={link.href}
                  class="block rounded-btn px-4 py-3 text-[15px] font-medium text-navy-700 hover:bg-blue-50 hover:text-blue-700"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>

          {mainNav.slice(1).map((link) => (
            <a href={link.href} class={navLinkClass}>{link.label}</a>
          ))}
        </nav>
      ) : (
        <nav aria-label={t.navPrincipal} class="hidden lg:flex items-center gap-1">
          {mainNavEn.map((link) => (
            <a href={link.href} class={navLinkClass}>{link.label}</a>
          ))}
        </nav>
      )}

      <div class="hidden lg:flex items-center gap-4">
        <div class="flex items-center gap-1" aria-label={t.langSwitcherLabel}>
          <Globe class="size-4 text-slate-400" aria-hidden="true" />
          <a
            href={esHref}
            aria-current={lang === 'es' ? 'true' : undefined}
            class:list={[langLinkClass, lang === 'es' ? 'text-navy-700' : 'text-slate-400 hover:text-navy-700']}
          >
            ES
          </a>
          <span class="text-slate-300" aria-hidden="true">/</span>
          <a
            href={enHref}
            aria-current={lang === 'en' ? 'true' : undefined}
            class:list={[langLinkClass, lang === 'en' ? 'text-navy-700' : 'text-slate-400 hover:text-navy-700']}
          >
            EN
          </a>
        </div>
        <Button href={contactoHref} variant="primary">{t.contacto}</Button>
      </div>

      <!-- Controles mobile -->
      <div class="flex items-center gap-2 lg:hidden">
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center size-11 rounded-full bg-[#25D366]/10 text-[#128C4A] hover:bg-[#25D366]/20 transition-colors"
          aria-label={t.whatsappAriaLabel(siteConfig.phoneDisplay)}
        >
          <MessageCircle class="size-5" aria-hidden="true" />
        </a>
        <button
          type="button"
          class="flex items-center justify-center size-11 rounded-btn text-navy-700 hover:bg-blue-50"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-trigger
          aria-label={t.openMenu}
          data-open-label={t.openMenu}
          data-close-label={t.closeMenu}
        >
          <Menu class="size-6" aria-hidden="true" data-menu-icon-open />
          <X class="size-6 hidden" aria-hidden="true" data-menu-icon-close />
        </button>
      </div>
    </div>
  </div>

  <!-- Panel mobile -->
  <div
    id="mobile-menu"
    class="lg:hidden border-t border-navy-700/10 bg-white"
    data-menu-panel
    hidden
  >
    {lang === 'es' ? (
      <nav aria-label={t.navPrincipalMobile} class="flex flex-col gap-1 px-4 py-4">
        <a href="/" class="mobile-nav-link">Inicio</a>
        <p class="px-3 pt-3 pb-1 text-small font-semibold uppercase tracking-wide text-slate-400">
          Soluciones
        </p>
        {solucionesDropdown.map((link) => (
          <a href={link.href} class="mobile-nav-link pl-6">{link.label}</a>
        ))}
        <a href="/servicios" class="mobile-nav-link">Servicios</a>
        <a href="/metodologia" class="mobile-nav-link">Metodología</a>
        <a href="/nosotros" class="mobile-nav-link">Nosotros</a>
        <a href="/casos" class="mobile-nav-link">Casos</a>
        <Button href="/contacto" variant="primary" class="mt-3 w-full">Contacto</Button>
        <div class="mt-4 pt-4 border-t border-navy-700/10 flex items-center gap-2 px-3 text-small font-semibold">
          <Globe class="size-4 text-slate-400" aria-hidden="true" />
          <a href={esHref} class="text-navy-700">ES</a>
          <span class="text-slate-300" aria-hidden="true">/</span>
          <a href={enHref} class="text-slate-400">EN</a>
        </div>
      </nav>
    ) : (
      <nav aria-label={t.navPrincipalMobile} class="flex flex-col gap-1 px-4 py-4">
        {mainNavEn.map((link) => (
          <a href={link.href} class="mobile-nav-link">{link.label}</a>
        ))}
        <Button href="/en/contact" variant="primary" class="mt-3 w-full">Contact</Button>
        <div class="mt-4 pt-4 border-t border-navy-700/10 flex items-center gap-2 px-3 text-small font-semibold">
          <Globe class="size-4 text-slate-400" aria-hidden="true" />
          <a href={esHref} class="text-slate-400">ES</a>
          <span class="text-slate-300" aria-hidden="true">/</span>
          <a href={enHref} class="text-navy-700">EN</a>
        </div>
      </nav>
    )}
  </div>
</header>

<style>
  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-btn);
    font-weight: 500;
    color: var(--color-navy-700);
  }
  .mobile-nav-link:hover {
    background: var(--color-blue-50);
    color: var(--color-blue-700);
  }
</style>

<script>
  function setupDropdown() {
    const wrapper = document.querySelector<HTMLElement>('[data-dropdown]');
    const trigger = wrapper?.querySelector<HTMLButtonElement>('[data-dropdown-trigger]');
    const panel = wrapper?.querySelector<HTMLElement>('[data-dropdown-panel]');
    const chevron = wrapper?.querySelector<HTMLElement>('[data-dropdown-chevron]');
    if (!wrapper || !trigger || !panel) return;

    const close = () => {
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-180');
    };
    const open = () => {
      panel.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      chevron?.classList.add('rotate-180');
    };

    trigger.addEventListener('click', () => {
      panel.hidden ? open() : close();
    });

    document.addEventListener('click', (event) => {
      if (!wrapper.contains(event.target as Node)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }

  function setupMobileMenu() {
    const trigger = document.querySelector<HTMLButtonElement>('[data-menu-trigger]');
    const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
    const iconOpen = document.querySelector<HTMLElement>('[data-menu-icon-open]');
    const iconClose = document.querySelector<HTMLElement>('[data-menu-icon-close]');
    if (!trigger || !panel) return;

    const openLabel = trigger.dataset.openLabel ?? 'Abrir menú';
    const closeLabel = trigger.dataset.closeLabel ?? 'Cerrar menú';

    const close = () => {
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      trigger.setAttribute('aria-label', openLabel);
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    };
    const open = () => {
      panel.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      trigger.setAttribute('aria-label', closeLabel);
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    };

    trigger.addEventListener('click', () => {
      panel.hidden ? open() : close();
    });

    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }

  setupDropdown();
  setupMobileMenu();
</script>

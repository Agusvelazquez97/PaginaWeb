---
/**
 * Botón base reutilizable. Variant "primary" = CTA de acción (blue-500);
 * usar como máximo un "primary" por vista (regla sección 3 de la spec).
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'onDark';
  size?: 'md' | 'lg';
  class?: string;
  target?: '_blank';
  rel?: string;
  type?: 'button' | 'submit';
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  target,
  rel,
  type = 'button',
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-btn font-heading ' +
  'transition-colors duration-200 min-h-11 focus-visible:outline-2 focus-visible:outline-offset-2';

const variants: Record<string, string> = {
  // Blanco sobre blue-500 da 3.68:1 (falla AA para texto chico). Se
  // compensa con texto grande + negrita para calificar como "large text"
  // (umbral WCAG 3:1) sin abandonar blue-500 como color primario (sección 3).
  primary: 'bg-blue-500 text-white font-bold hover:bg-blue-700 active:bg-blue-700',
  secondary:
    'bg-transparent text-navy-700 font-semibold border border-navy-700/20 hover:border-navy-700/40 hover:bg-blue-50',
  ghost: 'bg-transparent text-blue-700 font-semibold hover:bg-blue-50',
  onDark:
    'bg-transparent text-white font-semibold border border-white/30 hover:bg-white/10 hover:border-white/60',
};

const sizes: Record<string, string> = {
  // 18.66px (14pt) es el piso WCAG para que texto negrita cuente como
  // "large text" (umbral de contraste 3:1 en vez de 4.5:1) — 20px da margen.
  md: 'px-5 py-2.5 text-[20px] leading-none',
  lg: 'px-7 py-3.5 text-h3',
};

const classes = [base, variants[variant], sizes[size], className]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}

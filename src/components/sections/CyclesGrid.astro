---
/**
 * CyclesGrid — O2C / P2P / R2R / SSC-GBS (spec sección 4 y 6.9), página
 * Aviación & Logística.
 */
import { ArrowRightLeft, ShoppingCart, FileCheck, Building } from '@lucide/astro';
import Card from '@/components/ui/Card.astro';
import { aviacionCycles } from '@/data/content';

interface Cycle {
  code: string;
  name: string;
  items: string[];
}

interface Props {
  eyebrow?: string;
  heading?: string;
  cycles?: Cycle[];
}

const {
  eyebrow = 'Expertise financiero',
  heading = 'Los ciclos financieros que definimos, medimos y optimizamos.',
  cycles = aviacionCycles,
} = Astro.props;

const icons = [ArrowRightLeft, ShoppingCart, FileCheck, Building];
---

<section class="bg-bg-tint py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">
        {eyebrow}
      </p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">
        {heading}
      </h2>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cycles.map((cycle, i) => {
        const Icon = icons[i];
        return (
          <li data-reveal style={`transition-delay:${i * 60}ms`}>
            <Card class="h-full">
              <Icon class="size-7 text-blue-500" aria-hidden="true" />
              <p class="mt-4 font-heading font-extrabold text-navy-700 tracking-wide">
                {cycle.code}
              </p>
              <p class="text-small font-medium text-slate-500">{cycle.name}</p>
              <ul class="mt-4 space-y-2 border-t border-navy-700/10 pt-4">
                {cycle.items.map((item) => (
                  <li class="text-small text-slate-600 leading-snug">{item}</li>
                ))}
              </ul>
            </Card>
          </li>
        );
      })}
    </ul>
  </div>
</section>

---
/**
 * PainCards — grid de tarjetas de dolor + icono (spec sección 4). Reusado en
 * Inicio (versión condensada, spec 6.1.4) y en las páginas verticales
 * (diagnósticos completos, spec 6.2.2 y 6.3.2) con contenido propio por página.
 */
import Card from '@/components/ui/Card.astro';

interface Pain {
  icon: any;
  title: string;
  copy: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  items: Pain[];
}

const { eyebrow, heading, items } = Astro.props;
---

<section class="bg-bg-tint py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">{eyebrow}</p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">{heading}</h2>
    </div>

    <ul class:list={[
      'grid grid-cols-1 sm:grid-cols-2 gap-5',
      items.length >= 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4',
    ]}>
      {items.map((pain, i) => (
        <li data-reveal style={`transition-delay:${i * 60}ms`}>
          <Card as="article" tone="light" class="h-full">
            <pain.icon class="size-8 text-blue-500" aria-hidden="true" />
            <h3 class="mt-4 font-heading font-semibold text-navy-700 text-[17px] leading-snug">
              {pain.title}
            </h3>
            <p class="mt-2 text-small text-slate-500">{pain.copy}</p>
          </Card>
        </li>
      ))}
    </ul>
  </div>
</section>

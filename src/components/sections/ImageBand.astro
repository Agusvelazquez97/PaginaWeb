---
/**
 * ImageBand — franja de una imagen de apoyo real, usada con moderación
 * (como mucho una vez por página) para no romper el lenguaje de íconos +
 * tarjetas del resto del sitio. Pensada para reusar las fotos duotono ya
 * procesadas que quedaron sin slot (spec sección 8).
 */
interface Props {
  imageSrc: string;
  imageAlt: string;
  eyebrow: string;
  heading: string;
  copy: string;
}

const { imageSrc, imageAlt, eyebrow, heading, copy } = Astro.props;
---

<section class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div class="rounded-card overflow-hidden shadow-card aspect-[4/3] md:aspect-square" data-reveal>
        <img src={imageSrc} alt={imageAlt} class="h-full w-full object-cover" loading="lazy" />
      </div>
      <div data-reveal style="transition-delay:80ms">
        <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">{eyebrow}</p>
        <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">{heading}</h2>
        <p class="mt-4 text-lead text-slate-500 max-w-md">{copy}</p>
      </div>
    </div>
  </div>
</section>

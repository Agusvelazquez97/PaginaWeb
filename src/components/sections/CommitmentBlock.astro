---
/**
 * CommitmentBlock — spec 6.7. Cuatro compromisos reales del método DGV.
 * El mensaje de "todavía no hay casos" vive una sola vez en /casos (no se
 * repite acá) para no saturar el sitio con el mismo aviso.
 */
import { Repeat2, ShieldCheck, HeartHandshake, Building2 } from '@lucide/astro';
import Card from '@/components/ui/Card.astro';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

const commitmentsEs = [
  {
    icon: Repeat2,
    title: 'Un método de 4 pasos',
    copy: 'Previsibilidad: diagnóstico, estrategia, implementación y seguimiento, siempre en ese orden.',
  },
  {
    icon: ShieldCheck,
    title: 'Resultados medibles desde el día 1',
    copy: 'Cada proyecto incluye KPIs claros y reporting periódico, no promesas abstractas.',
  },
  {
    icon: HeartHandshake,
    title: 'Acceso directo al equipo',
    copy: 'Sin intermediarios ni burocracia: hablás con quien lleva adelante el proyecto.',
  },
  {
    icon: Building2,
    title: 'Trayectoria en multinacionales líderes',
    copy: 'Air France / KLM, DHL Express Argentina y Western Union.',
  },
];

const commitmentsEn = [
  {
    icon: Repeat2,
    title: 'A 4-step method',
    copy: 'Predictability: diagnosis, strategy, implementation and follow-up, always in that order.',
  },
  {
    icon: ShieldCheck,
    title: 'Measurable results from day 1',
    copy: 'Every project includes clear KPIs and periodic reporting, not abstract promises.',
  },
  {
    icon: HeartHandshake,
    title: 'Direct access to the team',
    copy: 'No intermediaries, no bureaucracy: you talk to whoever is running the project.',
  },
  {
    icon: Building2,
    title: 'Track record at leading multinationals',
    copy: 'Air France / KLM, DHL Express Argentina and Western Union.',
  },
];

const commitments = lang === 'en' ? commitmentsEn : commitmentsEs;
---

<section class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">
        {lang === 'en' ? 'How we work' : 'Cómo trabajamos'}
      </p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">
        {lang === 'en' ? 'Our commitment.' : 'Nuestro compromiso.'}
      </h2>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {commitments.map((item, i) => (
        <li data-reveal style={`transition-delay:${i * 60}ms`}>
          <Card class="h-full">
            <item.icon class="size-7 text-blue-500" aria-hidden="true" />
            <h3 class="mt-4 font-heading font-semibold text-navy-700 text-[16px] leading-snug">
              {item.title}
            </h3>
            <p class="mt-2 text-small text-slate-500">{item.copy}</p>
          </Card>
        </li>
      ))}
    </ul>
  </div>
</section>

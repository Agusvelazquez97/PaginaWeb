---
/**
 * FAQAccordion — reutilizable en verticales y contacto (spec sección 4).
 * Implementado con <details>/<summary> nativos: accesible por teclado y
 * lector de pantalla sin JS adicional.
 */
import { Plus } from '@lucide/astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: FAQItem[];
}

const { eyebrow = 'Preguntas frecuentes', heading, items } = Astro.props;
---

<section class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">{eyebrow}</p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">{heading}</h2>
    </div>

    <div class="divide-y divide-navy-700/10 border-y border-navy-700/10" data-reveal>
      {items.map((item) => (
        <details class="group py-5">
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-4 min-h-11 font-heading font-semibold text-navy-700 marker:content-none"
          >
            {item.question}
            <Plus
              class="size-5 shrink-0 text-blue-500 transition-transform group-open:rotate-45"
              aria-hidden="true"
            />
          </summary>
          <p class="mt-3 text-slate-600 leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

---
/**
 * DifferentiatorCards — spec sección 4. Reusado en Inicio (spec 6.1.6,
 * labels transversales) y en Aviación & Logística (spec 6.3.7, copy
 * específico del sector) con contenido propio por página.
 */
import Card from '@/components/ui/Card.astro';

interface Item {
  icon: any;
  title: string;
  copy: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: Item[];
}

const { eyebrow = 'Por qué DGV', heading, items } = Astro.props;
---

<section class="bg-bg-tint py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">{eyebrow}</p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">{heading}</h2>
    </div>

    <ul class:list={[
      'grid grid-cols-1 sm:grid-cols-2 gap-5',
      items.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3',
    ]}>
      {items.map((item, i) => (
        <li data-reveal style={`transition-delay:${i * 60}ms`}>
          <Card class="h-full">
            <item.icon class="size-8 text-blue-500" aria-hidden="true" />
            <h3 class="mt-4 font-heading font-semibold text-navy-700 text-[17px] leading-snug">
              {item.title}
            </h3>
            <p class="mt-2 text-small text-slate-500">{item.copy}</p>
          </Card>
        </li>
      ))}
    </ul>
  </div>
</section>

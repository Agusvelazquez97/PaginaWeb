---
/**
 * TeamGrid — spec sección 4: foto, nombre, rol, formación, bio, LinkedIn.
 * Fotos y LinkedIn están [FALTA] (ver PENDIENTES.md): se usan iniciales en
 * círculo (spec sección 8) y el ícono de LinkedIn no se muestra hasta tener
 * la URL real de cada persona.
 */
import { ExternalLink } from '@lucide/astro';
import Card from '@/components/ui/Card.astro';
import { team } from '@/data/team';
import { siteConfig } from '@/data/site';

// Person (JSON-LD) — spec 9.1. Sin "image" ni "sameAs": fotos y LinkedIn
// están [FALTA] (ver PENDIENTES.md).
const personSchemas = team.map((member) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: member.name,
  jobTitle: member.role,
  description: member.bio,
  worksFor: { '@type': 'Organization', name: siteConfig.name },
  ...(member.linkedIn ? { sameAs: [member.linkedIn] } : {}),
}));
---

<section class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">Nuestro equipo</p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">
        Las personas detrás de cada proyecto.
      </h2>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {team.map((member, i) => (
        <li data-reveal style={`transition-delay:${i * 60}ms`}>
          <Card class="h-full text-center">
            <div
              class="mx-auto size-20 rounded-full bg-navy-700 text-white flex items-center justify-center font-heading font-bold text-xl"
              aria-hidden="true"
            >
              {member.initials}
            </div>
            <p class="mt-4 font-heading font-semibold text-navy-700">{member.name}</p>
            <p class="text-small font-medium text-blue-700">{member.role}</p>
            <p class="mt-1 text-small text-slate-400">{member.formation}</p>
            <p class="mt-3 text-small text-slate-500">{member.bio}</p>
            {member.linkedIn && (
              <a
                href={member.linkedIn}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center justify-center size-11 rounded-full hover:bg-blue-50 text-blue-700"
                aria-label={`LinkedIn de ${member.name}`}
              >
                <ExternalLink class="size-5" aria-hidden="true" />
              </a>
            )}
          </Card>
        </li>
      ))}
    </ul>
  </div>

  {personSchemas.map((schema) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  ))}
</section>

---
/**
 * Módulo de prueba social reservado — spec sección 9.3.8: "Módulos de
 * prueba social construidos aunque vacíos, para poblarlos apenas exista
 * contenido." Copy honesto (DGV recién está lanzando, sin clientes
 * todavía): no se publican casos ni testimonios ficticios.
 */
import type { Lang } from '@/i18n/ui';

interface Props {
  label: string;
  lang?: Lang;
}

const { label, lang = 'es' } = Astro.props;
---

<section class="bg-bg-tint py-16 md:py-20">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8" data-reveal>
    <div
      class="rounded-card border-2 border-dashed border-navy-700/15 bg-white p-10 text-center"
    >
      {lang === 'en' ? (
        <>
          <p class="font-heading font-semibold text-navy-700">Cases and testimonials</p>
          <p class="mt-2 text-small text-slate-500 max-w-md mx-auto">
            We're just launching DGV Business Consulting, so we don't have {label} to show yet.
            As we onboard our first clients, you'll find their real results here, with their
            authorization.
          </p>
        </>
      ) : (
        <>
          <p class="font-heading font-semibold text-navy-700">Casos y testimonios</p>
          <p class="mt-2 text-small text-slate-500 max-w-md mx-auto">
            Estamos recién lanzando DGV Business Consulting, así que todavía no tenemos {label} para
            mostrar. A medida que sumemos los primeros clientes, vas a encontrar acá sus resultados
            reales, con su autorización.
          </p>
        </>
      )}
    </div>
  </div>
</section>

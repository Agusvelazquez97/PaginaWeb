---
/**
 * Detalle del método para /metodologia (spec 6.5). Extiende los 4 pasos con
 * entregables y duración por etapa, con contenido real provisto por el
 * cliente (ver PENDIENTES.md). El cliente describe el proceso en 4 fases
 * algo distintas ("Diagnóstico / Análisis / Estrategia / Implementación y
 * seguimiento"); se repartió ese contenido en los 4 pasos que ya usa el
 * resto del sitio (Diagnóstico/Estrategia/Implementación/Seguimiento) para
 * no reestructurar la presentación pública: "Análisis" queda absorbido en
 * Diagnóstico (su entregable ya estaba incluido ahí) y "Implementación y
 * seguimiento" se separa en los dos pasos existentes.
 */
import Card from '@/components/ui/Card.astro';
import { methodStepsAviacion } from '@/data/content';
import { methodStepsAviacionEn } from '@/data/content.en';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

const extrasEs = [
  {
    deliverable: 'Mapa de brechas + mapa de oportunidades + matriz de priorización + quick wins + informe ejecutivo.',
    duration: '2 a 3 semanas.',
  },
  {
    deliverable: 'Plan estratégico de mejora: objetivos, prioridades, iniciativas, KPIs y roadmap a 30/60/90 días.',
    duration: '3 a 5 días hábiles.',
  },
  {
    deliverable: 'Roadmap de implementación + tablero de KPIs.',
    duration: '3 a 6 meses, según la complejidad del proyecto.',
  },
  {
    deliverable: 'Informes de avance + seguimiento ejecutivo + informe final de resultados.',
    duration: 'Continuo durante toda la implementación.',
  },
];

const extrasEn = [
  {
    deliverable: 'Gap map + opportunity map + prioritization matrix + quick wins + executive report.',
    duration: '2 to 3 weeks.',
  },
  {
    deliverable: 'Strategic improvement plan: objectives, priorities, initiatives, KPIs and a 30/60/90-day roadmap.',
    duration: '3 to 5 business days.',
  },
  {
    deliverable: 'Implementation roadmap + KPI dashboard.',
    duration: '3 to 6 months, depending on project complexity.',
  },
  {
    deliverable: 'Progress reports + executive follow-up + final results report.',
    duration: 'Continuous throughout implementation.',
  },
];

const stepsBase = lang === 'en' ? methodStepsAviacionEn : methodStepsAviacion;
const extras = lang === 'en' ? extrasEn : extrasEs;
const steps = stepsBase.map((step, i) => ({ ...step, ...extras[i] }));

const tools = lang === 'en'
  ? ['SAP', 'ERP', 'Business Intelligence', 'Executive dashboards']
  : ['SAP', 'ERP', 'Business Intelligence', 'Dashboards ejecutivos'];

const labels = lang === 'en'
  ? { deliverables: 'Deliverables', duration: 'Typical duration', tools: 'Tools' }
  : { deliverables: 'Entregables', duration: 'Duración típica', tools: 'Herramientas' };
---

<section class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <ol class="space-y-5">
      {steps.map((step, i) => (
        <li data-reveal style={`transition-delay:${i * 70}ms`}>
          <Card tone="tint" class="grid grid-cols-1 md:grid-cols-[auto_1fr_auto_auto] gap-x-8 gap-y-4 items-start">
            <div class="flex items-center gap-3 md:flex-col md:items-start">
              <span class="text-slate-400 font-heading font-extrabold text-4xl leading-none" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <step.icon class="size-7 text-blue-500" aria-hidden="true" />
            </div>
            <div>
              <h2 class="font-heading font-semibold text-navy-700 text-h3">{step.title}</h2>
              <p class="mt-1 text-small text-slate-500 max-w-sm">{step.copy}</p>
            </div>
            <div class="md:border-l md:border-navy-700/10 md:pl-6">
              <p class="text-small font-semibold uppercase tracking-wide text-slate-400">
                {labels.deliverables}
              </p>
              <p class="mt-1 text-small text-slate-500">{step.deliverable}</p>
            </div>
            <div class="md:border-l md:border-navy-700/10 md:pl-6">
              <p class="text-small font-semibold uppercase tracking-wide text-slate-400">
                {labels.duration}
              </p>
              <p class="mt-1 text-small text-slate-500">{step.duration}</p>
            </div>
          </Card>
        </li>
      ))}
    </ol>

    <div class="mt-10 text-center" data-reveal>
      <p class="text-small font-semibold uppercase tracking-wide text-slate-400 mb-3">
        {labels.tools}
      </p>
      <ul class="flex flex-wrap justify-center gap-2">
        {tools.map((tool) => (
          <li class="rounded-full border border-navy-700/15 bg-bg-tint px-4 py-1.5 text-small font-medium text-navy-700">
            {tool}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

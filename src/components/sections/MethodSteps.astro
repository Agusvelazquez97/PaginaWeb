---
/**
 * MethodSteps — spec sección 4 y 6.1.5 ("resumido"). Texto base: sección 6.5.
 * 4 pasos: Diagnóstico → Estrategia → Implementación → Seguimiento.
 */
import { ClipboardList, Target, Rocket, ChartLine } from '@lucide/astro';
import Card from '@/components/ui/Card.astro';

const steps = [
  {
    icon: ClipboardList,
    title: 'Diagnóstico',
    copy: 'Relevamiento de procesos y estructura financiera.',
  },
  {
    icon: Target,
    title: 'Estrategia',
    copy: 'Plan de acción y hoja de ruta priorizada.',
  },
  {
    icon: Rocket,
    title: 'Implementación',
    copy: 'Ejecución con acompañamiento de DGV.',
  },
  {
    icon: ChartLine,
    title: 'Seguimiento',
    copy: 'Reporting ejecutivo y mejora continua.',
  },
];
---

<section class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-14" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">Nuestro método</p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">
        Un proceso claro, resultados concretos.
      </h2>
    </div>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {steps.map((step, i) => (
        <li data-reveal style={`transition-delay:${i * 70}ms`}>
          <Card tone="tint" class="h-full relative">
            <span class="text-blue-200 font-heading font-extrabold text-4xl leading-none" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <step.icon class="size-7 text-blue-500 mt-4" aria-hidden="true" />
            <h3 class="mt-3 font-heading font-semibold text-navy-700 text-h3">{step.title}</h3>
            <p class="mt-2 text-small text-slate-500">{step.copy}</p>
          </Card>
        </li>
      ))}
    </ol>
  </div>
</section>

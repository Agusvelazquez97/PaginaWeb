---
/**
 * MethodSteps — 4 pasos del método (spec sección 4). Reusado en Inicio
 * (versión resumida, spec 6.1.5) y en las páginas verticales (versión
 * completa, spec 6.2.6 y 6.3.6 —esta última menciona SAP/ERP) con
 * contenido propio por página. Base de texto: spec sección 6.5.
 */
import Card from '@/components/ui/Card.astro';

interface Step {
  icon: any;
  title: string;
  copy: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  steps: Step[];
}

const { eyebrow = 'Nuestro método', heading, steps } = Astro.props;
---

<section class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-14" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">{eyebrow}</p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">{heading}</h2>
    </div>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {steps.map((step, i) => (
        <li data-reveal style={`transition-delay:${i * 70}ms`}>
          <Card tone="tint" class="h-full relative">
            <span class="text-blue-200 font-heading font-extrabold text-4xl leading-none" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <step.icon class="size-7 text-blue-500 mt-4" aria-hidden="true" />
            <h3 class="mt-3 font-heading font-semibold text-navy-700 text-h3">{step.title}</h3>
            <p class="mt-2 text-small text-slate-500">{step.copy}</p>
          </Card>
        </li>
      ))}
    </ol>
  </div>
</section>

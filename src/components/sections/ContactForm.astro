---
/**
 * ContactForm — spec sección 7.1. Campos: Nombre*, Empresa*, Email*,
 * Teléfono, Tipo (select)*, Mensaje. Envío por fetch a un servicio externo
 * (Formspree / Web3Forms) — spec: "no usar <form> con submit nativo hacia
 * uno mismo". Sin `siteConfig.formEndpoint` configurado, el formulario
 * queda visible y validado pero avisa que todavía no está conectado, en
 * vez de simular un envío exitoso que no ocurrió.
 */
import { siteConfig } from '@/data/site';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const hasEndpoint = Boolean(siteConfig.formEndpoint);
const sla = lang === 'en' ? siteConfig.contactSlaEn : siteConfig.contactSla;

const copy = {
  es: {
    name: 'Nombre',
    company: 'Empresa',
    email: 'Email',
    phone: 'Teléfono',
    type: 'Tipo',
    selectOption: 'Seleccioná una opción',
    typePyme: 'PyME',
    typeAviacion: 'Aviación / Logística',
    typeOther: 'Otro',
    message: 'Mensaje',
    honeypotLabel: 'No completar este campo',
    submit: 'Enviar mensaje',
    pendingNote: '[[PENDIENTE: conectar el formulario a Formspree/Web3Forms — ver PENDIENTES.md]]',
  },
  en: {
    name: 'Name',
    company: 'Company',
    email: 'Email',
    phone: 'Phone',
    type: 'Type',
    selectOption: 'Select an option',
    typePyme: 'SME',
    typeAviacion: 'Aviation / Logistics',
    typeOther: 'Other',
    message: 'Message',
    honeypotLabel: 'Do not fill in this field',
    submit: 'Send message',
    pendingNote: '[[PENDING: connect the form to Formspree/Web3Forms — see PENDIENTES.md]]',
  },
}[lang];
---

<form id="contact-form" class="space-y-5" data-endpoint={siteConfig.formEndpoint} data-lang={lang} novalidate>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="name" class="block text-small font-medium text-navy-700 mb-1.5">
        {copy.name} <span aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="w-full min-h-11 rounded-btn border border-navy-700/20 px-4 py-2.5 text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-2"
      />
    </div>
    <div>
      <label for="company" class="block text-small font-medium text-navy-700 mb-1.5">
        {copy.company} <span aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="company"
        name="company"
        required
        autocomplete="organization"
        class="w-full min-h-11 rounded-btn border border-navy-700/20 px-4 py-2.5 text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-2"
      />
    </div>
    <div>
      <label for="email" class="block text-small font-medium text-navy-700 mb-1.5">
        {copy.email} <span aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="w-full min-h-11 rounded-btn border border-navy-700/20 px-4 py-2.5 text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-2"
      />
    </div>
    <div>
      <label for="phone" class="block text-small font-medium text-navy-700 mb-1.5">
        {copy.phone}
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        autocomplete="tel"
        class="w-full min-h-11 rounded-btn border border-navy-700/20 px-4 py-2.5 text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-2"
      />
    </div>
  </div>

  <div>
    <label for="type" class="block text-small font-medium text-navy-700 mb-1.5">
      {copy.type} <span aria-hidden="true">*</span>
    </label>
    <select
      id="type"
      name="type"
      required
      class="w-full min-h-11 rounded-btn border border-navy-700/20 px-4 py-2.5 text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      <option value="">{copy.selectOption}</option>
      <option value="PyME">{copy.typePyme}</option>
      <option value="Aviación-Logística">{copy.typeAviacion}</option>
      <option value="Otro">{copy.typeOther}</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-small font-medium text-navy-700 mb-1.5">
      {copy.message}
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class="w-full rounded-btn border border-navy-700/20 px-4 py-2.5 text-slate-600 focus-visible:outline-2 focus-visible:outline-offset-2"
    ></textarea>
  </div>

  <!-- Honeypot anti-spam: campo oculto que un humano nunca completa -->
  <div class="hidden" aria-hidden="true">
    <label for="website">{copy.honeypotLabel}</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div>
    <button
      type="submit"
      class="w-full sm:w-auto inline-flex items-center justify-center min-h-11 px-7 py-2.5 rounded-btn bg-blue-500 text-white font-heading font-bold text-[20px] leading-none hover:bg-blue-700 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      {copy.submit}
    </button>
    <p class="mt-3 text-small text-slate-500">{sla}</p>
  </div>

  <p
    id="form-status"
    class="text-small font-medium"
    role="status"
    aria-live="polite"
  ></p>

  {!hasEndpoint && (
    <p class="text-small text-slate-400">
      {copy.pendingNote}
    </p>
  )}
</form>

<script>
  import { trackEvent } from '@/scripts/analytics';

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    if (!form || !status) return;

    const endpoint = form.dataset.endpoint;
    const lang = form.dataset.lang === 'en' ? 'en' : 'es';
    const messages = {
      es: {
        notConnected: 'El formulario todavía no está conectado. Mientras tanto, escribinos por WhatsApp.',
        sending: 'Enviando...',
        success: '¡Listo! Recibimos tu mensaje.',
        error: 'No pudimos enviar el mensaje. Escribinos por WhatsApp o reintentá en un momento.',
      },
      en: {
        notConnected: "The form isn't connected yet. In the meantime, message us on WhatsApp.",
        sending: 'Sending...',
        success: "Done! We've received your message.",
        error: "We couldn't send the message. Message us on WhatsApp or try again shortly.",
      },
    }[lang];

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      if (data.get('website')) return; // honeypot: descarta silenciosamente

      if (!endpoint) {
        status.textContent = messages.notConnected;
        status.className = 'text-small font-medium text-slate-500';
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      submitButton.disabled = true;
      status.textContent = messages.sending;
      status.className = 'text-small font-medium text-slate-500';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) throw new Error('request failed');

        form.reset();
        status.textContent = messages.success;
        status.className = 'text-small font-medium text-success';
        trackEvent('form_submit', { form: 'contact', type: String(data.get('type') ?? ''), lang });
      } catch {
        status.textContent = messages.error;
        status.className = 'text-small font-medium text-red-600';
      } finally {
        submitButton.disabled = false;
      }
    });
  }

  initContactForm();
</script>

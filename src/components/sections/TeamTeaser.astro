---
/**
 * Team teaser — spec 6.1.8. Fotos [FALTA]: se usan iniciales en círculo
 * como estado intermedio (spec sección 8, "plan de imágenes").
 */
import { ArrowRight } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import { team } from '@/data/team';
---

<section class="bg-bg-tint py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">
        Nuestro equipo
      </p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">
        Las personas detrás de cada proyecto.
      </h2>
    </div>

    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {team.map((member, i) => (
        <li class="text-center" data-reveal style={`transition-delay:${i * 60}ms`}>
          <div
            class="mx-auto size-24 md:size-28 rounded-full bg-navy-700 text-white flex items-center justify-center font-heading font-bold text-2xl"
            aria-hidden="true"
          >
            {member.initials}
          </div>
          <p class="mt-4 font-heading font-semibold text-navy-700">{member.name}</p>
          <p class="text-small text-slate-500">{member.role}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex justify-center" data-reveal>
      <Button href="/nosotros" variant="secondary">
        Conocé al equipo completo
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
    </div>
  </div>
</section>

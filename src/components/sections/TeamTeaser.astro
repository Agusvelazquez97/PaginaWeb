---
/**
 * Team teaser — spec 6.1.8. Fotos reales (ver PENDIENTES.md).
 */
import { ArrowRight } from '@lucide/astro';
import Button from '@/components/ui/Button.astro';
import { team } from '@/data/team';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

// Traducción de los cargos (los nombres no se traducen). El equipo en sí
// (src/data/team.ts) sigue siendo la única fuente de verdad en español.
const roleEn: Record<string, string> = {
  Fundador: 'Founder',
  Fundadora: 'Founder',
  'Consultora Senior': 'Senior Consultant',
  'Consultor Digital': 'Digital Consultant',
};
---

<section class="bg-bg-tint py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">
        {lang === 'en' ? 'Our team' : 'Nuestro equipo'}
      </p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">
        {lang === 'en' ? 'The people behind every project.' : 'Las personas detrás de cada proyecto.'}
      </h2>
    </div>

    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {team.map((member, i) => (
        <li class="text-center" data-reveal style={`transition-delay:${i * 60}ms`}>
          <img
            src={member.photo}
            alt=""
            class="mx-auto size-24 md:size-28 rounded-full object-cover"
            width="224"
            height="224"
            loading="lazy"
          />
          <p class="mt-4 font-heading font-semibold text-navy-700">{member.name}</p>
          <p class="text-small text-slate-500">{lang === 'en' ? (roleEn[member.role] ?? member.role) : member.role}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex justify-center" data-reveal>
      <Button href={lang === 'en' ? '/en/about' : '/nosotros'} variant="secondary">
        {lang === 'en' ? 'Meet the full team' : 'Conocé al equipo completo'}
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
    </div>
  </div>
</section>

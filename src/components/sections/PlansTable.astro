---
/**
 * PlansTable — comparativa de los 4 planes PyME (spec sección 4 y 6.9).
 * Se resuelve como grid de tarjetas (no <table>) para que en mobile apilen
 * sin scroll horizontal, cumpliendo la regla de accesibilidad de la spec.
 */
import { Check } from '@lucide/astro';
import Card from '@/components/ui/Card.astro';
import { pymePlans } from '@/data/content';

interface Plan {
  name: string;
  forWhom: string;
  includes: string[];
}

interface Props {
  eyebrow?: string;
  heading?: string;
  plans?: Plan[];
}

const { eyebrow = 'Planes', heading = 'Un plan que crece con tu negocio.', plans = pymePlans } = Astro.props;
---

<section class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">{eyebrow}</p>
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">
        {heading}
      </h2>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {plans.map((plan, i) => (
        <li data-reveal style={`transition-delay:${i * 60}ms`}>
          <Card class="h-full flex flex-col">
            <p class="font-heading font-extrabold text-blue-700 tracking-wide">{plan.name}</p>
            <p class="mt-2 text-small text-slate-500">{plan.forWhom}</p>
            <ul class="mt-5 space-y-3 border-t border-navy-700/10 pt-5">
              {plan.includes.map((line) => (
                <li class="flex items-start gap-2 text-small text-slate-600">
                  <Check class="size-4 shrink-0 text-blue-500 mt-0.5" aria-hidden="true" />
                  <span>{line}</span>
                </li>
              ))}
            </ul>
          </Card>
        </li>
      ))}
    </ul>
  </div>
</section>

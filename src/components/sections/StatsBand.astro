---
/**
 * StatsBand — KPIs con contador animado (spec sección 4 y 6.3.8).
 * El conteo respeta prefers-reduced-motion (si está activo, muestra el
 * valor final directamente, sin animar).
 */
interface Stat {
  value: number;
  suffix: string;
  label: string;
}

interface Props {
  stats?: Stat[];
}

const defaultStats: Stat[] = [
  { value: 20, suffix: '+', label: 'años de experiencia financiera y operativa en el sector.' },
  { value: 3, suffix: '', label: 'países de contraloría de operaciones financieras.' },
  { value: 100, suffix: '%', label: 'de atención desde el inicio de cada proyecto.' },
];

const { stats = defaultStats } = Astro.props;
---

<section class="bg-navy-900 py-16 md:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <ul class="grid grid-cols-1 sm:grid-cols-3 gap-10 text-center">
      {stats.map((stat) => (
        <li>
          <p class="font-heading font-extrabold text-white text-5xl md:text-6xl tabular-nums">
            <span data-stat-value={stat.value}>0</span>{stat.suffix}
          </p>
          <p class="mt-3 text-blue-100 text-small max-w-[16rem] mx-auto">{stat.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  function animateCount(el: HTMLElement) {
    const target = Number(el.dataset.statValue);
    const duration = 1200;
    const start = performance.now();

    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = String(Math.round(target * eased));
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  function initStatsBand() {
    const targets = document.querySelectorAll<HTMLElement>('[data-stat-value]');
    if (targets.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion || !('IntersectionObserver' in window)) {
      targets.forEach((el) => (el.textContent = el.dataset.statValue ?? '0'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.5 }
    );

    targets.forEach((el) => observer.observe(el));
  }

  initStatsBand();
</script>

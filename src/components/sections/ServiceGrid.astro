---
/**
 * ServiceGrid / ServiceCard — spec sección 4: "icono, título, descripción,
 * resultado". Usado en /soluciones-pymes con dos sets de datos distintos
 * (Lo que resolvemos, Servicios) — spec 6.2.3 y 6.2.5 / 6.9.
 */
import Card from '@/components/ui/Card.astro';

interface ServiceItem {
  icon: any;
  title: string;
  copy: string;
  result?: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  items: ServiceItem[];
  tone?: 'light' | 'tint';
}

const { eyebrow, heading, items, tone = 'light' } = Astro.props;
const sectionBg = tone === 'tint' ? 'bg-bg-tint' : 'bg-white';
---

<section class={`${sectionBg} py-20 md:py-28`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12" data-reveal>
      {eyebrow && (
        <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">{eyebrow}</p>
      )}
      <h2 class="mt-3 font-heading font-bold text-h1 text-navy-700">{heading}</h2>
    </div>

    <ul
      class:list={[
        'grid grid-cols-1 sm:grid-cols-2 gap-5',
        items.length % 3 === 0 || items.length >= 5 ? 'lg:grid-cols-3' : 'lg:grid-cols-2',
      ]}
    >
      {items.map((item, i) => (
        <li data-reveal style={`transition-delay:${i * 50}ms`}>
          <Card tone={tone === 'tint' ? 'light' : 'tint'} class="h-full">
            <item.icon class="size-8 text-blue-500" aria-hidden="true" />
            <h3 class="mt-4 font-heading font-semibold text-navy-700 text-[17px] leading-snug">
              {item.title}
            </h3>
            <p class="mt-2 text-small text-slate-500">{item.copy}</p>
            {item.result && (
              <p class="mt-3 text-small font-medium text-blue-700">{item.result}</p>
            )}
          </Card>
        </li>
      ))}
    </ul>
  </div>
</section>

---
/**
 * Contacto — spec sección 6.8, 7.1 y 7.2. Agenda (Calendly) complementa al
 * formulario, no lo reemplaza.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import FAQAccordion from '@/components/sections/FAQAccordion.astro';
import Button from '@/components/ui/Button.astro';
import { Mail, MessageCircle, MapPin, CalendarClock } from '@lucide/astro';
import { siteConfig, whatsappHref } from '@/data/site';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import FAQSchema from '@/components/seo/FAQSchema.astro';

const faqItems = [
  {
    question: '¿Cómo cobran los servicios?',
    answer:
      'El diagnóstico inicial tiene un valor cerrado, así sabés el costo antes de arrancar. A partir de ahí, según el alcance de la implementación, trabajamos por proyecto o con un abono mensual.',
  },
  {
    question: '¿Cuánto dura un proyecto típico?',
    answer:
      'Depende del alcance: el diagnóstico inicial toma entre 2 y 3 semanas, la definición de estrategia unos días más, y la implementación y seguimiento suele extenderse entre 3 y 6 meses según la complejidad del proyecto.',
  },
  {
    question: '¿Trabajan de forma remota o presencial?',
    answer:
      'Somos presenciales en Buenos Aires, pero la modalidad se adapta a cada proyecto: con empresas del interior del país trabajamos de forma remota, coordinando encuentros presenciales puntuales cuando el proyecto lo requiere. Y en Buenos Aires también trabajamos de forma remota cuando la presencialidad no es necesaria.',
  },
];
---

<BaseLayout
  title="Contacto | Agendá un diagnóstico sin cargo — DGV Business Consulting"
  description="Escribinos por WhatsApp, mail o completá el formulario. Te respondemos en 24 h y coordinamos una conversación sin cargo sobre tu empresa."
>
  <BreadcrumbSchema items={[{ name: 'Inicio', path: '/' }, { name: 'Contacto', path: '/contacto' }]} />
  <FAQSchema items={faqItems} />
  <Hero
    variant="image"
    fallbackLabel="imagen del equipo DGV"
    imageSrc="/images/team/equipo-nosotros.jpg"
    eyebrow="Contacto"
    title="Hablemos."
    subtitle="Sin compromiso, sin burocracia — una conversación sobre cómo impulsar tu empresa."
    primaryCta={{ label: 'Enviá tu mensaje', href: '#formulario' }}
  />

  <section id="formulario" class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16">
      <div data-reveal>
        <h2 class="font-heading font-semibold text-navy-700 text-h3 mb-6">Envianos un mensaje</h2>
        <ContactForm />
      </div>

      <div class="space-y-5" data-reveal style="transition-delay:80ms">
        <div class="rounded-card bg-bg-tint p-6">
          <p class="font-heading font-semibold text-navy-700 mb-4">Canales directos</p>
          <ul class="space-y-3">
            <li>
              <a
                href={`mailto:${siteConfig.email}`}
                class="inline-flex items-center gap-2 min-h-11 text-slate-600 hover:text-blue-700"
              >
                <Mail class="size-4 shrink-0" aria-hidden="true" />
                {siteConfig.email}
              </a>
            </li>
            <li>
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 min-h-11 text-slate-600 hover:text-blue-700"
              >
                <MessageCircle class="size-4 shrink-0" aria-hidden="true" />
                {siteConfig.phoneDisplay}
              </a>
            </li>
            <li class="inline-flex items-start gap-2 text-slate-500">
              <MapPin class="size-4 shrink-0 mt-0.5" aria-hidden="true" />
              {siteConfig.location}
            </li>
          </ul>
        </div>

        <div class="rounded-card bg-bg-tint p-6">
          <p class="font-heading font-semibold text-navy-700 mb-2 inline-flex items-center gap-2">
            <CalendarClock class="size-4" aria-hidden="true" />
            Agendar una conversación
          </p>
          <p class="text-small text-slate-500 mb-4">
            Elegí vos mismo el día y horario para una charla de 30 minutos sin cargo, sin ir y
            venir de mails.
          </p>
          <Button href={siteConfig.calendlyUrl} target="_blank" rel="noopener noreferrer" variant="secondary" class="w-full">
            Agendar en Calendly
          </Button>
        </div>
      </div>
    </div>
  </section>

  <FAQAccordion heading="Antes de escribirnos" items={faqItems} />
</BaseLayout>

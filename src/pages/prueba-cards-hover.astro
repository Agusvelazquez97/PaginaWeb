---
/**
 * Página de prueba aislada — alternativa sobria al DriftWall: hover-lift
 * sutil en las cards. Reusa el componente y los datos reales de producción
 * (PainCards + pymePains, spec 6.1.4 / 6.2.2) sin modificarlos; el único
 * agregado es el CSS de hover de este archivo. No enlazada desde ningún
 * menú ni registrada en i18n/routes.ts; noindex explícito.
 * Borrar este archivo alcanza para revertir el experimento por completo
 * — no toca ningún otro archivo del sitio.
 */
import '@/styles/global.css';
import PainCards from '@/components/sections/PainCards.astro';
import { pymePains } from '@/data/content';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Prueba — Hover en cards</title>
    <style is:global>
      .test-note {
        background: #0b1e3f;
        color: #dde3f0;
        text-align: center;
        padding: 16px;
        font-size: 14px;
        font-family: Arial, Helvetica, sans-serif;
      }
      .test-note strong {
        color: #ffffff;
      }

      /* ---- Alternativa: hover-lift sutil sobre la Card real del sitio ---- */
      .rounded-card {
        transition:
          transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
          box-shadow 0.32s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .rounded-card:hover,
      .rounded-card:focus-within {
        transform: translateY(-6px);
        box-shadow: 0 22px 40px -18px rgba(15, 23, 42, 0.28);
      }
      .rounded-card svg {
        transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .rounded-card:hover svg,
      .rounded-card:focus-within svg {
        transform: translateY(-2px);
      }

      @media (prefers-reduced-motion: reduce) {
        .rounded-card,
        .rounded-card svg {
          transition: none;
        }
        .rounded-card:hover,
        .rounded-card:focus-within {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <p class="test-note">
      Página de prueba — alternativa sobria: <strong>hover-lift</strong> en las cards reales de
      "Los desafíos que frenan el crecimiento" (Inicio). No enlazada, <code>noindex</code>.
    </p>

    <PainCards
      eyebrow="El diagnóstico"
      heading="Los desafíos que frenan el crecimiento"
      items={pymePains}
    />

    <script src="@/scripts/reveal.ts"></script>
  </body>
</html>

---
/**
 * Services (EN) — traducción fiel de src/pages/servicios.astro. Feature
 * experimental de i18n (ver PENDIENTES.md).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import ServiceGrid from '@/components/sections/ServiceGrid.astro';
import CTASection from '@/components/sections/CTASection.astro';
import Button from '@/components/ui/Button.astro';
import { ArrowRight } from '@lucide/astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import { serviceFamiliesEn } from '@/data/content.en';
---

<BaseLayout
  title="Services | Finance, processes, technology and compliance — DGV Business Consulting"
  description="All of DGV Business Consulting's services grouped by family: finance and accounting, processes and operations, strategy, technology, compliance and labor."
>
  <BreadcrumbSchema items={[{ name: 'Home', path: '/en' }, { name: 'Services', path: '/en/services' }]} />
  <Hero
    variant="image"
    fallbackLabel="team meeting image (services hero)"
    imageSrc="/images/general/servicios-equipo.jpg"
    eyebrow="Services"
    title="Comprehensive expertise for every stage of your company."
    subtitle="Six areas of work, one team: from day-to-day accounting to digital transformation and corporate governance."
    primaryCta={{ label: 'Book a diagnostic', href: '/en/contact' }}
  />

  <nav aria-label="Service families" class="bg-white border-b border-navy-700/10 py-6">
    <ul class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-wrap gap-2">
      {serviceFamiliesEn.map((family) => (
        <li>
          <a
            href={`#${family.slug}`}
            class="inline-flex items-center min-h-11 rounded-full border border-navy-700/15 px-4 text-small font-medium text-navy-700 hover:bg-blue-50 hover:text-blue-700"
          >
            {family.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {serviceFamiliesEn.map((family, i) => (
    <div id={family.slug}>
      <ServiceGrid
        heading={family.name}
        items={family.items}
        tone={i % 2 === 0 ? 'light' : 'tint'}
      />
    </div>
  ))}

  <section class="bg-navy-900 py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <p class="text-blue-200 font-semibold uppercase tracking-wide text-small">
        What's your situation?
      </p>
      <h2 class="mt-3 font-heading font-bold text-h2 text-white">
        Choose your path to see the full solution.
      </h2>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/en/solutions-for-smes" variant="onDark" size="lg">
          Solutions for SMEs <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
        <Button href="/en/aviation-logistics" variant="onDark" size="lg">
          Aviation & Logistics Industry <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
      </div>
    </div>
  </section>

  <CTASection
    title="Not sure where to start?"
    subtitle="Book a free diagnostic and we'll help you prioritize."
    cta={{ label: 'Book a diagnostic', href: '/en/contact' }}
  />
</BaseLayout>

---
/**
 * Aviation & Logistics (EN) — traducción fiel de
 * src/pages/aviacion-logistica.astro. Feature experimental de i18n
 * (ver PENDIENTES.md).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import PainCards from '@/components/sections/PainCards.astro';
import ServiceGrid from '@/components/sections/ServiceGrid.astro';
import CyclesGrid from '@/components/sections/CyclesGrid.astro';
import ImageBand from '@/components/sections/ImageBand.astro';
import AuthorityBand from '@/components/sections/AuthorityBand.astro';
import MethodSteps from '@/components/sections/MethodSteps.astro';
import DifferentiatorCards from '@/components/sections/DifferentiatorCards.astro';
import StatsBand from '@/components/sections/StatsBand.astro';
import CTASection from '@/components/sections/CTASection.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import {
  aviacionProblemsEn,
  aviacionPillarsEn,
  aviacionCyclesEn,
  methodStepsAviacionEn,
  aviacionDifferentiatorsEn,
  aviacionStatsEn,
} from '@/data/content.en';
---

<BaseLayout
  title="Financial consulting for aviation and logistics | O2C, P2P, BCRA compliance — DGV"
  description="Financial consulting specialized in aviation and logistics: CFO advisory, O2C/P2P/R2R process optimization, BCRA compliance and applied technology."
>
  <BreadcrumbSchema
    items={[
      { name: 'Home', path: '/en' },
      { name: 'Aviation & Logistics Industry', path: '/en/aviation-logistics' },
    ]}
  />
  <Hero
    variant="image"
    fallbackLabel="aviation / logistics image (hero)"
    imageSrc="/images/aviacion/terminal.jpg"
    eyebrow="Aviation & Logistics Industry"
    title="From financial turbulence to sustained performance."
    subtitle="We turn the aviation sector's complex financial reality into a competitive advantage."
    tags={['Airlines', 'Cargo', 'Handling', 'Airport Operators']}
    primaryCta={{ label: 'Request a conversation', href: '/en/contact' }}
    secondaryCta={{ label: 'See expertise', href: '#expertise' }}
  />

  <PainCards
    eyebrow="The diagnosis"
    heading="An industry with no room for financial mistakes."
    items={aviacionProblemsEn}
  />

  <ServiceGrid
    eyebrow="Our approach"
    heading="Four pillars for your financial operation."
    items={aviacionPillarsEn}
    tone="tint"
  />

  <div id="expertise">
    <CyclesGrid
      eyebrow="Financial expertise"
      heading="The financial cycles we define, measure and optimize."
      cycles={aviacionCyclesEn}
    />
  </div>

  <ImageBand
    imageSrc="/images/aviacion/finanzas.jpg"
    imageAlt=""
    eyebrow="Real financial control"
    heading="Every cycle, under control."
    copy="O2C, P2P and R2R managed with full visibility, so month-end close is never a surprise."
  />

  <AuthorityBand lang="en" />

  <MethodSteps eyebrow="Our method" heading="A clear method, measurable results." steps={methodStepsAviacionEn} />

  <DifferentiatorCards
    eyebrow="Why DGV"
    heading="What sets us apart in the aviation and logistics industry."
    items={aviacionDifferentiatorsEn}
  />

  <StatsBand stats={aviacionStatsEn} />

  <CTASection
    title="Request a conversation."
    subtitle="No commitment, with full focus on the results of your financial operation."
    cta={{ label: 'Request a conversation', href: '/en/contact' }}
  />
</BaseLayout>

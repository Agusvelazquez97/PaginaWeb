---
/**
 * Contact (EN) — traducción fiel de src/pages/contacto.astro. Feature
 * experimental de i18n (ver PENDIENTES.md). Las respuestas del FAQ son
 * traducción literal de las respuestas reales ya aprobadas en español —
 * no se agrega contenido nuevo.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/sections/ContactForm.astro';
import FAQAccordion from '@/components/sections/FAQAccordion.astro';
import Button from '@/components/ui/Button.astro';
import { Mail, MessageCircle, MapPin, CalendarClock } from '@lucide/astro';
import { siteConfig, whatsappHrefEn } from '@/data/site';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
import FAQSchema from '@/components/seo/FAQSchema.astro';

const faqItems = [
  {
    question: 'How do you charge for your services?',
    answer:
      "The initial diagnostic has a fixed price, so you know the cost before starting. From there, depending on the scope of the implementation, we work on a per-project basis or with a monthly retainer.",
  },
  {
    question: 'How long does a typical project take?',
    answer:
      "It depends on the scope: the initial diagnostic takes 2 to 3 weeks, defining the strategy a few days more, and implementation and follow-up usually run 3 to 6 months depending on the project's complexity.",
  },
  {
    question: 'Do you work remotely or in person?',
    answer:
      "We work in person in Buenos Aires, but the approach adapts to each project: with companies outside the city we work remotely, coordinating occasional in-person meetings when the project requires it. And in Buenos Aires we also work remotely when being on-site isn't necessary.",
  },
];
---

<BaseLayout
  title="Contact | Book a free diagnostic — DGV Business Consulting"
  description="Message us on WhatsApp, email, or fill out the form. We'll reply within 24 h and set up a free conversation about your company."
>
  <BreadcrumbSchema items={[{ name: 'Home', path: '/en' }, { name: 'Contact', path: '/en/contact' }]} />
  <FAQSchema items={faqItems} />
  <section class="bg-bg-tint pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center" data-reveal>
      <p class="text-blue-700 font-semibold uppercase tracking-wide text-small">Contact</p>
      <h1 class="mt-3 font-heading font-bold text-h1 text-navy-700">Let's talk.</h1>
      <p class="mt-4 text-lead text-slate-500">
        No commitment, no red tape — a conversation about how to drive your business forward.
      </p>
    </div>
  </section>

  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 lg:gap-16">
      <div data-reveal>
        <h2 class="font-heading font-semibold text-navy-700 text-h3 mb-6">Send us a message</h2>
        <ContactForm lang="en" />
      </div>

      <div class="space-y-5" data-reveal style="transition-delay:80ms">
        <div class="rounded-card bg-bg-tint p-6">
          <p class="font-heading font-semibold text-navy-700 mb-4">Direct channels</p>
          <ul class="space-y-3">
            <li>
              <a
                href={`mailto:${siteConfig.email}`}
                class="inline-flex items-center gap-2 min-h-11 text-slate-600 hover:text-blue-700"
              >
                <Mail class="size-4 shrink-0" aria-hidden="true" />
                {siteConfig.email}
              </a>
            </li>
            <li>
              <a
                href={whatsappHrefEn}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 min-h-11 text-slate-600 hover:text-blue-700"
              >
                <MessageCircle class="size-4 shrink-0" aria-hidden="true" />
                {siteConfig.phoneDisplay}
              </a>
            </li>
            <li class="inline-flex items-start gap-2 text-slate-500">
              <MapPin class="size-4 shrink-0 mt-0.5" aria-hidden="true" />
              {siteConfig.location}
            </li>
          </ul>
        </div>

        <div class="rounded-card bg-bg-tint p-6">
          <p class="font-heading font-semibold text-navy-700 mb-2 inline-flex items-center gap-2">
            <CalendarClock class="size-4" aria-hidden="true" />
            Schedule a conversation
          </p>
          <p class="text-small text-slate-500 mb-4">
            Pick the day and time yourself for a free 30-minute call, no back-and-forth emails.
          </p>
          <Button href={siteConfig.calendlyUrl} target="_blank" rel="noopener noreferrer" variant="secondary" class="w-full">
            Schedule on Calendly
          </Button>
        </div>
      </div>
    </div>
  </section>

  <FAQAccordion eyebrow="Frequently asked questions" heading="Before you reach out" items={faqItems} />
</BaseLayout>

---
/**
 * Methodology (EN) — traducción fiel de src/pages/metodologia.astro.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import MethodStepsDetailed from '@/components/sections/MethodStepsDetailed.astro';
import CTASection from '@/components/sections/CTASection.astro';
import BreadcrumbSchema from '@/components/seo/BreadcrumbSchema.astro';
---

<BaseLayout
  title="Methodology | A clear method, measurable results — DGV Business Consulting"
  description="Diagnosis, strategy, implementation and follow-up: the 4-stage method DGV uses to organize, measure and make the companies it works with profitable."
>
  <BreadcrumbSchema items={[{ name: 'Home', path: '/en' }, { name: 'Methodology', path: '/en/methodology' }]} />
  <Hero
    variant="image"
    fallbackLabel="team working image (methodology hero)"
    imageSrc="/images/general/metodologia-equipo.jpg"
    eyebrow="Methodology"
    title="A clear method, measurable results."
    subtitle="Four stages, one thread running through all of them: assess, decide, execute and measure — with executive reporting at every step."
    primaryCta={{ label: "Let's start with the diagnostic", href: '/en/contact' }}
  />

  <MethodStepsDetailed lang="en" />

  <CTASection
    title="Let's start with the diagnostic."
    subtitle="The first step is understanding where your business stands today. No strings attached."
    cta={{ label: "Let's start with the diagnostic", href: '/en/contact' }}
  />
</BaseLayout>
